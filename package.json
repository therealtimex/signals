{
  "name": "@realtimex/signals",
  "version": "0.2.3",
  "private": true,
  "description": "Signals \u2014 Local-first Social GTM & Relationship Knowledge Graph",
  "type": "module",
  "bin": {
    "signals": "./dist/cli.js"
  },
  "scripts": {
    "preinstall": "node scripts/node-runtime-contract.mjs",
    "dev": "next dev --turbopack -p ${RTX_PORT:-${PORT:-3000}}",
    "build": "next build",
    "start": "next start",
    "build:cli": "tsup",
    "db:generate": "drizzle-kit generate",
    "db:ensure": "node scripts/ensure-signals-data-dir.mjs",
    "db:migrate": "npm run db:ensure && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --project unit && vitest run --project latency",
    "test:skill-package": "node scripts/test-signals-publish-skill-package.mjs",
    "test:signals-pp-cli": "node scripts/test-signals-pp-cli-import.mjs && node scripts/test-signals-pp-cli-targets.mjs && node scripts/test-signals-pp-cli-launcher.mjs && node scripts/test-signals-pp-cli-npm-package.mjs",
    "test:standalone-artifact": "node scripts/test-standalone-artifact.mjs",
    "test:plugin-package": "node scripts/test-verify-signals-plugin-provision.mjs && node scripts/test-release-signature.mjs && node scripts/test-realtimex-plugin-package.mjs && node scripts/test-x-publish-agent-browser.mjs",
    "test:provision-verifier": "node scripts/test-verify-signals-plugin-provision.mjs",
    "test:qa-local-app": "node scripts/qa/test-signals-qa-local-app.mjs",
    "verify:node-runtime": "node scripts/node-runtime-contract.mjs && node scripts/test-node-runtime-contract.mjs",
    "verify:marketplace-versions": "node scripts/verify-marketplace-versions.mjs",
    "verify:writing-corpus": "node scripts/verify-writing-corpus-manifest.mjs",
    "test:writing-corpus": "node scripts/test-verify-writing-corpus-manifest.mjs",
    "test:writing-skill": "node scripts/verify-signals-writing-skill.mjs",
    "merge:release-manifests": "node scripts/merge-release-manifests.mjs",
    "validate:release-artifacts": "node scripts/validate-release-artifacts.mjs",
    "sign:release-manifest": "node scripts/sign-release-manifest.mjs",
    "verify:fresh-import": "vitest run --project import-safety",
    "test:integration": "vitest run --project integration",
    "check": "npm run typecheck && npm run lint && npm run check:agent-tools-openapi && npm run automation:test && npm run verify:writing-corpus && npm run test:writing-corpus && npm run test:writing-skill && npm run test:coverage && npm run test:skill-package && npm run test:provision-verifier && npm run test:qa-local-app && npm run db:migrate && npm run build",
    "qa:local-app:provision": "node scripts/qa/provision-signals-qa-local-app.mjs",
    "qa:local-app:cleanup": "node scripts/qa/cleanup-signals-qa-local-app.mjs",
    "qa:local-app:verify": "node scripts/qa/verify-signals-local-app-hygiene.mjs",
    "package:realtimex-plugin": "bash scripts/package-realtimex-plugin.sh",
    "build:standalone-artifact": "bash scripts/build-standalone-artifact.sh",
    "generate:agent-tools-openapi": "node scripts/generate-agent-tools-openapi.mjs",
    "check:agent-tools-openapi": "node scripts/check-agent-tools-openapi.mjs",
    "contract:heartbeat": "SIGNALS_CONTRACT_PROBES=1 vitest run --project contract",
    "seed:demo": "vite-node --config vitest.config.ts scripts/seed-demo-data.ts",
    "automation:check-target": "node scripts/app-automation/scripts/check-signals-target.mjs",
    "automation:record-guide-tour": "node scripts/app-automation/flows/record-guide-tour.mjs",
    "automation:capture-guide-assets": "node scripts/app-automation/flows/capture-guide-assets.mjs",
    "automation:convert-guide-video": "node scripts/app-automation/flows/convert-guide-video.mjs",
    "automation:test": "node --test \"scripts/app-automation/**/*.test.mjs\"",
    "build:signals-pp-cli": "node scripts/build-signals-pp-cli.mjs",
    "package:signals-pp-cli-npm": "node scripts/package-signals-pp-cli-npm.mjs",
    "publish:signals-pp-cli-npm": "node scripts/publish-signals-pp-cli-npm.mjs",
    "gate": "npm run check",
    "prepublishOnly": "npm run build:cli",
    "doctor": "npx react-doctor@latest"
  },
  "files": [
    "dist/",
    "src/",
    "public/",
    "guide/",
    "docs/",
    ".claude/skills/",
    "rtx-manifest.json",
    "rtx-local-app.example.json",
    "next.config.mjs",
    "tsconfig.json",
    "drizzle.config.ts",
    "postcss.config.mjs",
    "components.json",
    "package.json"
  ],
  "engines": {
    "node": ">=22.16.0 <23"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "commander": "^14.0.3",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.45.1",
    "fflate": "^0.8.3",
    "image-size": "^2.0.2",
    "lucide-react": "^0.500.0",
    "nanoid": "^5.1.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "open": "^10.0.0",
    "playwright": "^1.58.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "happy-dom": "^20.11.2",
    "react-doctor": "^0.9.12",
    "tsup": "^8.5.1",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "signals",
    "social-gtm",
    "knowledge-graph",
    "relationship-management",
    "crm",
    "social-media",
    "ai-agents",
    "claude",
    "x",
    "twitter",
    "linkedin",
    "automation"
  ],
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/therealtimex/signals.git"
  },
  "homepage": "https://github.com/therealtimex/signals"
}
