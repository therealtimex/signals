{
  "name": "@realtimex/signals",
  "version": "0.1.10",
  "description": "Signals — Local-first Social GTM & Relationship Knowledge Graph",
  "type": "module",
  "bin": {
    "signals": "./dist/cli.js"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "build:cli": "tsup",
    "db:generate": "drizzle-kit generate",
    "db:ensure": "node scripts/ensure-signals-data-dir.mjs",
    "db:migrate": "npm run db:ensure && drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage --project unit && vitest run --project latency",
    "test:skill-package": "node scripts/test-signals-publish-skill-package.mjs",
    "test:plugin-package": "node scripts/test-verify-signals-plugin-provision.mjs && node scripts/test-realtimex-plugin-package.mjs && node scripts/test-x-publish-agent-browser.mjs",
    "test:provision-verifier": "node scripts/test-verify-signals-plugin-provision.mjs",
    "verify:marketplace-versions": "node scripts/verify-marketplace-versions.mjs",
    "verify:fresh-import": "vitest run --project import-safety",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "smoke:core": "playwright test e2e/smoke",
    "check": "npm run typecheck && npm run lint && npm run test:coverage && npm run test:skill-package && npm run test:provision-verifier && npm run db:migrate && npm run build",
    "package:realtimex-plugin": "bash scripts/package-realtimex-plugin.sh",
    "build:standalone-artifact": "bash scripts/build-standalone-artifact.sh",
    "gate": "npm run check",
    "prepublishOnly": "npm run build:cli",
    "doctor": "npx react-doctor@latest"
  },
  "files": [
    "dist/",
    "src/",
    "public/",
    "guide/",
    "docs/",
    ".claude/skills/",
    "rtx-manifest.json",
    "rtx-local-app.example.json",
    "next.config.mjs",
    "tsconfig.json",
    "drizzle.config.ts",
    "postcss.config.mjs",
    "components.json",
    "package.json"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/react": "^3.19.0",
    "@tiptap/starter-kit": "^3.19.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.0",
    "cmdk": "^1.1.1",
    "commander": "^14.0.3",
    "cron-parser": "^5.5.0",
    "drizzle-orm": "^0.45.1",
    "fflate": "^0.8.3",
    "image-size": "^2.0.2",
    "lucide-react": "^0.500.0",
    "nanoid": "^5.1.0",
    "next": "^16.1.6",
    "next-themes": "^0.4.6",
    "open": "^10.0.0",
    "playwright": "^1.58.2",
    "radix-ui": "^1.4.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-force-graph-2d": "^1.29.1",
    "react-markdown": "^10.1.0",
    "recharts": "^2.15.4",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.1.18",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.8.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/better-sqlite3": "^7.6.0",
    "@types/react-dom": "^19.2.4",
    "@vitest/coverage-v8": "^3.2.4",
    "drizzle-kit": "^0.31.8",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.1",
    "happy-dom": "^20.11.2",
    "react-doctor": "^0.9.12",
    "tsup": "^8.5.1",
    "vitest": "^3.0.0"
  },
  "keywords": [
    "signals",
    "social-gtm",
    "knowledge-graph",
    "relationship-management",
    "crm",
    "social-media",
    "ai-agents",
    "claude",
    "x",
    "twitter",
    "linkedin",
    "automation"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/therealtimex/signals.git"
  },
  "homepage": "https://github.com/therealtimex/signals"
}
