{
  "id": "47e45f71-3279-42f5-8e95-731de01b6eae",
  "name": "signals",
  "display_name": "Signals",
  "description": "Local-first social GTM and relationship knowledge graph",
  "app_type": "node",
  "runtime": {
    "kind": "node",
    "version": "20.x",
    "managedBy": "realtimex"
  },
  "artifactContract": {
    "schemaVersion": 2,
    "releaseManifest": "release-manifest.json",
    "signature": "release-manifest.sig.json",
    "selector": "platform-arch",
    "supportedTargets": [
      "darwin-arm64",
      "darwin-x64",
      "win32-x64",
      "linux-x64"
    ]
  },
  "healthPath": "/api/health",
  "homePath": "/dashboard",
  "permissions": [
    "credentials.list",
    "credentials.use",
    "webhook.trigger",
    "llm.embed",
    "llm.chat",
    "desktop.browser",
    "desktop.runtime-sessions"
  ],
  "configuration": {
    "command": "{runtime.executable}",
    "args": ["server.js"],
    "working_dir": "{artifact_dir}",
    "home_url": "http://localhost:{port}/dashboard",
    "env": {
      "HOSTNAME": "127.0.0.1",
      "PORT": "{port}"
    }
  },
  "notes": "Consumed by the RealtimeX marketplace v2 local-app contract. Select and verify one platform-architecture artifact, then resolve {runtime.executable}, {artifact_dir}, and {port} at install/start time. Production does not use npx."
}
