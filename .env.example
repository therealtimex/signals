# Signals Environment Variables
# Copy to .env.local and fill in your values

# Anthropic API Key (for Claude Agent SDK + Vercel AI SDK)
# Get yours at https://console.anthropic.com/
ANTHROPIC_API_KEY=

# X/Twitter API Credentials (optional — for API access)
# Get yours at https://developer.x.com/
X_CLIENT_ID=
X_CLIENT_SECRET=

# LinkedIn API Credentials (optional — for API access)
# Get yours at https://developer.linkedin.com/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Gmail / Google API Credentials (optional — for Google Contacts + Gmail metadata)
# Get yours at https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# App settings (defaults work for local development)
PORT=3000
SIGNALS_DATA_DIR=~/.signals

# Writing approval (optional; defaults to explicit review before publishing)
# SIGNALS_WRITING_APPROVAL_POLICY=explicit

# Persona generation (optional)
# SIGNALS_PERSONA_GENERATION_MODE=structured_workflow
# PERSONA_AGENT_JOB_TIMEOUT_MS=300000
# Email intelligence: SMTP probing is off by default. Predicted addresses are excluded from
# automation unless this explicit opt-in is enabled. Environment values lock the UI setting.
# SIGNALS_EMAIL_SMTP_PROBE_ENABLED=0
# SIGNALS_ALLOW_PREDICTED_EMAIL_AUTOMATION=0
